{
  "name": "dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted homelab dashboard. React, Tailwind CSS and an Express backend with WebSocket live updates.",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:mock": "concurrently -n api,web -c yellow,cyan \"MOCK=1 node --watch server/index.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "start:mock": "MOCK=1 node server/index.js",
    "typecheck": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanikHenz/dashboard2.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JanikHenz/dashboard2/issues"
  },
  "homepage": "https://github.com/JanikHenz/dashboard2#readme",
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "express": "^5.2.1",
    "pigpio-client": "^1.5.3",
    "ping": "^1.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
